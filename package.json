{
    "name": "products-sale-crm",
    "version": "1.0.0",
    "description": "Sale CRM - Sales CRM Product (Deals, Tasks, Meetings, Incentives, Tickets, Reports, Dashboard)",
    "type": "module",
    "main": "src/index.js",
    "scripts": {
        "dev": "nodemon src/index.js",
        "start": "node src/index.js",
        "dev:dev": "npx dotenv -e environments/dev/.env -- nodemon src/index.js",
        "start:dev": "npx dotenv -e environments/dev/.env -- node src/index.js",
        "dev:staging": "npx dotenv -e environments/staging/.env -- nodemon src/index.js",
        "start:staging": "npx dotenv -e environments/staging/.env -- node src/index.js",
        "start:prod": "npx dotenv -e environments/prod/.env -- node src/index.js",
        "lint": "eslint src/",
        "test": "jest --coverage"
    },
    "dependencies": {
        "axios": "^1.13.6",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-validator": "^7.0.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.6.5",
        "nodemailer": "^7.0.13",
        "pino": "^10.3.1",
        "redis": "^5.10.0",
        "sequelize": "^6.35.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "dotenv-cli": "^11.0.0",
        "eslint": "^8.54.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.1.0",
        "sequelize-cli": "^6.6.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
